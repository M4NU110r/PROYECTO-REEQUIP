{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Lanzar index.html en Chrome",
            "type": "pwa-chrome",
            "request": "launch",
            "file": "${workspaceFolder}/index.html",
            "urlFilter": "*index.html*",
            "skipFiles": [
                "*google.com/**",
                "*gstatic.com/**"
            ]
        }
    ]
}

